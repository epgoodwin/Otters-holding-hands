# Dropbox API Configuration
# Create an app at https://www.dropbox.com/developers/apps
# Use "Scoped access" and "Full Dropbox" or "App folder"
# Required scopes: files.metadata.read, files.content.read, sharing.read

# Long-lived access token (generate from the Dropbox App Console)
DROPBOX_ACCESS_TOKEN=your_access_token_here

# The shared link to the client's "Client Share" folder on Dropbox
# Example: https://www.dropbox.com/scl/fo/abc123/...
DROPBOX_SHARED_LINK=https://www.dropbox.com/scl/fo/your-folder-link

# Client/Company branding
NEXT_PUBLIC_CLIENT_NAME=Acme Corp
NEXT_PUBLIC_COMPANY_NAME=Your Agency Name
