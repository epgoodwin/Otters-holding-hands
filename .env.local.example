# Dropbox API Configuration
# Create an app at https://www.dropbox.com/developers/apps
# Use "Scoped access" and "Full Dropbox"
# Required scopes: files.metadata.read, files.content.read, sharing.read

# --- RECOMMENDED: Long-lived credentials (token auto-refreshes, never expires) ---
# Get these from your Dropbox App Console (Settings tab):
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here
# Get the refresh token by running: node scripts/get-refresh-token.mjs
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# --- FALLBACK: Short-lived access token (expires every 4 hours, not recommended) ---
# Only used if the three vars above are not set.
# DROPBOX_ACCESS_TOKEN=your_access_token_here

# The shared link to the client's folder on Dropbox
# Example: https://www.dropbox.com/scl/fo/abc123/...
DROPBOX_SHARED_LINK=https://www.dropbox.com/scl/fo/your-folder-link

# Client/Company branding
NEXT_PUBLIC_CLIENT_NAME=Acme Corp
NEXT_PUBLIC_COMPANY_NAME=Your Agency Name
